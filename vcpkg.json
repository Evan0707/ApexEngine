{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "apex-engine",
  "version-string": "0.1.0",
  "builtin-baseline": "d13c536672dced4b8c671955ea7d057a1b7a1ff8",
  "dependencies": [
    "catch2",
    "cgltf",
    "entt",
    "glm",
    "joltphysics",
    "nlohmann-json",
    {
      "name": "sdl3",
      "features": [
        "vulkan"
      ]
    },
    "stb",
    "vk-bootstrap",
    "vulkan-headers",
    "vulkan-loader",
    "vulkan-memory-allocator",
    {
      "name": "imgui",
      "features": [
        "sdl3-binding",
        "vulkan-binding"
      ]
    }
  ],
  "features": {
    "profiling": {
      "description": "Tracy CPU profiler client, used by the windows-profile preset",
      "dependencies": [
        {
          "name": "tracy",
          "default-features": false,
          "features": [
            "on-demand"
          ]
        }
      ]
    }
  }
}
